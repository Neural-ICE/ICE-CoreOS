[Unit]
Description=Verify and publish the Neural ICE offline release generation
RequiresMountsFor=/var/lib/neural-ice/data
After=var-lib-neural\x2dice-data.mount
Before=network-pre.target neural-ice-payload-apply.service
Wants=network-pre.target
ConditionPathExists=/var/lib/neural-ice/data/release/CLOSURE
ConditionPathExists=!/var/lib/neural-ice/data/OFFLINE-READY

[Service]
Type=oneshot
# Full images and model blobs are copied, verified and synced before publication.
TimeoutStartSec=2h
ExecStart=/usr/local/bin/neural-ice-seed-import.sh
RemainAfterExit=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
# /run/neural-ice is created by neural-ice-hostname-init, which is not ordered
# before this unit and may not have run (or may have failed) yet. A required
# ReadWritePaths= that is absent makes systemd fail this unit at the NAMESPACE
# step, before the script runs and without a line of output: the lab GX10
# first boots of 2026-09-10 died there. The path is optional here (`-`); the
# script writes nothing under it.
ReadWritePaths=/var/lib/neural-ice/data -/run/neural-ice

[Install]
WantedBy=multi-user.target
