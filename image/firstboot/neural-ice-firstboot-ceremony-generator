#!/usr/bin/env bash
# Runs on the installed appliance at systemd generator time. The pinned
# image unit orders After=systemd-tmpfiles-setup.service (explicitly, and
# implicitly through PrivateTmp=yes) while systemd-sysext/confext are
# Requires=+After= this gate and Before= tmpfiles-setup: a cycle. An /etc
# drop-in cannot undo the PrivateTmp=yes edge, so a generated unit shadows
# /usr/lib until the medium is re-pinned to an appliance that ships the fixed
# unit. BRIDGE: retire this generator and the /etc overlay at that re-pin.
set -euo pipefail
umask 022

normal_dir=${1:?}
[[ "$normal_dir" == /* && "$normal_dir" != / ]] || exit 1
[[ -d "$normal_dir" && ! -L "$normal_dir" ]] || exit 1

src=/etc/neural-ice/firstboot-tpm-ceremony.service
[[ -f "$src" && ! -L "$src" ]] || exit 1
grep -Fq 'DefaultDependencies=no' "$src" || exit 1
! grep -E '^(After|Before)=.*systemd-tmpfiles-setup\.service' "$src" || exit 1
! grep -E '^(After|Before)=.*sysinit\.target' "$src" || exit 1
# PrivateTmp=yes|true|1 re-adds After=systemd-tmpfiles-setup.service.
! grep -Eq '^PrivateTmp=(yes|true|on|1)[[:space:]]*$' "$src" || exit 1
install -m 0644 -- "$src" "$normal_dir/neural-ice-firstboot-tpm-ceremony.service"
