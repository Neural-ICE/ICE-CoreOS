[Unit]
Description=Neural ICE mandatory TPM owner ceremony and runtime trust gate
Documentation=https://github.com/Neural-ICE/ICE-CoreOS/blob/main/docs/ADR-0015-installer-trust-anchor-uki-verity.md
# DefaultDependencies would After=basic.target and cycle with sshd.socket
# (After=sysinit, Before=sockets). The pinned image also After=tmpfiles-setup;
# systemd-sysext Requires this unit and is Before=tmpfiles-setup, which is
# already a cycle. Do not After= or Before= tmpfiles or sysinit: consumers
# already After= this unit, and sysext's Before=tmpfiles pulls it early enough.
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target network.target network-online.target systemd-user-sessions.service sshd.service
OnFailure=emergency.target
OnFailureJobMode=isolate
RequiresMountsFor=/var/lib/neural-ice/ota

[Service]
Type=oneshot
ExecStart=/usr/libexec/neural-ice-firstboot-tpm-ceremony
RemainAfterExit=yes
# ADR-0050 lab-trust, lever B (MVP 1.0): the sealed OTA-state / preseal
# attestation (TPM point #4) is fail-open in the relaxed posture, so a preseal
# refusal logs and lets the boot proceed instead of dropping to
# emergency.target (the .67 brick, 2026-09-17). Override to strict to re-harden
# (a drop-in with Environment=NEURALICE_SEALED_OTA_STATE=strict). Every other
# trust anchor (Secure Boot, LUKS/SRK/device-root, root) stays enforced.
Environment=NEURALICE_SEALED_OTA_STATE=relaxed
UMask=0077
# ProtectSystem=strict remounts /run read-only except RuntimeDirectory and
# ReadWritePaths. The ceremony execs device-root, tpm-state, access-profile
# anchor and cryptsetup, each of which install(1)s its own /run directory.
RuntimeDirectory=neural-ice-owner-ceremony neural-ice-device-root neural-ice-tpm-state neural-ice-ota-tpm-state neural-ice-access-profile-anchor
RuntimeDirectoryMode=0700
# `disconnected`, NOT `yes`. PrivateTmp=yes silently adds
# After=systemd-tmpfiles-setup.service; systemd-sysext/confext carry
# Requires=+After= on this gate (root-capable extensions must wait for it) and
# are Before=systemd-tmpfiles-setup.service — with `yes` that is a cycle,
# which systemd 257 breaks by skipping sysext/confext at random. A private,
# disconnected tmpfs keeps the sandbox and adds no tmpfiles ordering
# (verified on systemd 257: `systemctl show -p After`). The ceremony never
# uses /tmp anyway; every mktemp lives under its RuntimeDirectory.
PrivateTmp=disconnected
ProtectSystem=strict
ReadWritePaths=/var/lib/neural-ice/ota /run/neural-ice-owner-ceremony /run/neural-ice-device-root /run/neural-ice-tpm-state /run/neural-ice-ota-tpm-state /run/neural-ice-access-profile-anchor /run/cryptsetup
StandardOutput=journal+console
StandardError=journal+console

[Install]
RequiredBy=multi-user.target
