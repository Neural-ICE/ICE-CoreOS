[connection]
# DGX Spark management NIC (Realtek 10GbE, ACPI name verified on the hardware).
# DHCP -> guarantees admin/SSH access even if the ConnectX-7 is down/bricked.
id=mgmt-enP7s7
type=ethernet
interface-name=enP7s7
autoconnect=true
autoconnect-priority=100

[ethernet]

[ipv4]
method=auto

[ipv6]
# No IPv6 on the appliance (Owner decision, 2026-09-11). With method=auto on a
# LAN without an IPv6 router, NetworkManager held the interface in ip-check for
# 51 s (router solicitation, then a 45 s DHCPv6 transaction) before declaring
# startup complete -- 0.1 s after nm-online's 60 s timeout, so
# NetworkManager-wait-online failed and every unit After=network-online.target
# waited a minute for nothing (lab GX10, first boot C27, 2026-09-10).
method=disabled
