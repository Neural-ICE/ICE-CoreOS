# ICE-CoreOS — SINGLE-PURPOSE INSTALLER image (DGX Spark)
# = Secure Boot SIGNED (validated) base image + auto-install service.
# A produced medium boots ONE signed UKI from \EFI\BOOT\BOOTAA64.EFI and carries
# no boot manager, no second EFI binary and no kernel of its own: Live or Install
# is decided when the medium is cut (MEDIA_MODE) and stated by a signature, not
# by a menu (ADR-0015; review 2026-09-01, P0 #2).
#
# The base image is a build-arg so the installer can be built for any channel:
#   sudo podman build --platform linux/arm64 -f image/Containerfile.installer \
#     --build-arg BASE_IMAGE=ghcr.io/neural-ice/neural-ice-coreos@sha256:<digest> \
#     -t localhost/ice-coreos-installer:local .
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# All the partitioning/encryption tools required by the auto-install are
# already in the CentOS Stream 10 bootc base: sfdisk/partx/wipefs/blkid/lsblk
# (util-linux), cryptsetup, systemd-cryptenroll, mkfs.fat/ext4/xfs.
# `veritysetup` is a distinct EL10 package: a symlink to cryptsetup resolves by
# name but silently exposes the LUKS applet, which cannot activate dm-verity.
# Install the package release matching the base image's cryptsetup exactly.
# The ARM64 systemd UKI stub is split into
# systemd-boot-unsigned on EL10. Fetch the exact ARM64 RPM and verify the
# checksum published in the CentOS Stream 10 AppStream primary metadata. A
# mirror removal may stop a rebuild, but mutable metadata or bytes can never
# silently change the installer at this revision.
RUN stub_rpm=/tmp/systemd-boot-unsigned-257-31.el10.aarch64.rpm \
    && curl --proto '=https' --tlsv1.2 --fail --show-error --silent --location \
      --output "$stub_rpm" \
      https://mirror.stream.centos.org/10-stream/AppStream/aarch64/os/Packages/systemd-boot-unsigned-257-31.el10.aarch64.rpm \
    && printf '%s  %s\n' \
      d4370eabdbd2085b5e1679cf68f577bf9288ad22f8077f8f274c56857d342300 \
      "$stub_rpm" | sha256sum --check --strict \
    && dnf --disablerepo='*' -y install "$stub_rpm" \
    && rm -f "$stub_rpm" \
    && verity_evr="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' cryptsetup)" \
    && dnf --disablerepo='nvidia*' -y install \
      "veritysetup-${verity_evr}" \
      fuse-overlayfs-1.17-1.el10.aarch64 \
    && dnf clean all \
    && test ! -L /usr/sbin/veritysetup \
    && veritysetup --help | grep -Fq -- '--panic-on-corruption' \
    && test "$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' fuse-overlayfs)" = 1.17-1.el10.aarch64 \
    && test -x /usr/bin/fuse-overlayfs \
    && test -s /usr/lib/systemd/boot/efi/linuxaa64.efi.stub

# The live UKI is rebuilt below by build-installer-usb.sh, but bootc installs
# the source image's prebuilt /usr/lib/modules/<kver>/initramfs.img. Copying only
# into the live dracut workspace therefore leaves first boot on the stale hook
# inherited from BASE_IMAGE. Stage the checkout's complete installed-boot module
# and regenerate that one generic initramfs now; the installer build then carries
# the same bounded ESP coldplug and TPM policy parser on both sides of the reboot.
COPY image/initramfs/91neural-ice-tpm-policy/module-setup.sh \
     /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/module-setup.sh
COPY image/initramfs/91neural-ice-tpm-policy/neural-ice-tpm-policy.sh \
     /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/neural-ice-tpm-policy.sh
COPY image/initramfs/91neural-ice-tpm-policy/neural-ice-tpm-policy.service \
     /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/neural-ice-tpm-policy.service
COPY image/initramfs/91neural-ice-tpm-policy/systemd-cryptsetup-policy.conf \
     /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/systemd-cryptsetup-policy.conf
COPY image/lib/tpm2-nv-public.sh \
     /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/tpm2-nv-public.sh
RUN bash -euxo pipefail -c '\
    shopt -s nullglob; \
    kernels=(/usr/lib/modules/*); \
    (( ${#kernels[@]} == 1 )); \
    kver=${kernels[0]##*/}; \
    initramfs=${kernels[0]}/initramfs.img; \
    chmod 0755 \
      /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/module-setup.sh \
      /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/neural-ice-tpm-policy.sh; \
    chmod 0644 /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/tpm2-nv-public.sh; \
    chmod 0644 /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/neural-ice-tpm-policy.service; \
    chmod 0644 /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/systemd-cryptsetup-policy.conf; \
    dracut --force --no-hostonly --reproducible --kver "$kver" "$initramfs"; \
    cmp \
      <(lsinitrd -f /var/lib/dracut/hooks/pre-trigger/01-neural-ice-tpm-policy.sh "$initramfs") \
      /usr/lib/dracut/modules.d/91neural-ice-tpm-policy/neural-ice-tpm-policy.sh; \
    marker=$(lsinitrd -f /etc/neural-ice/installer-media "$initramfs" 2>/dev/null || true); \
    if [[ -n "$marker" ]]; then \
      echo "installed initramfs unexpectedly carries the installer-media marker" >&2; \
      exit 1; \
    fi; \
    lsinitrd -f /usr/lib/systemd/system/neural-ice-tpm-policy.service "$initramfs" \
      | grep -F "Before=cryptsetup-pre.target" >/dev/null; \
    lsinitrd -f /etc/systemd/system/systemd-cryptsetup@.service.d/10-neural-ice-policy.conf "$initramfs" \
      | grep -F "Requires=neural-ice-tpm-policy.service" >/dev/null'

# Auto-install service (gated by the neuralice.autoinstall kernel argument).
COPY ota/neural-ice-autoinstall.sh      /usr/local/bin/neural-ice-autoinstall.sh
# Pinned appliance digests still ship the first-boot ceremony After=tmpfiles
# with DefaultDependencies=yes. The installer stages this drop-in onto the
# deployment /etc so first boot cannot form a sockets/sysext ordering cycle.
COPY image/firstboot/10-neural-ice-firstboot-ceremony-sysinit.conf \
     /usr/lib/neural-ice/firstboot-ceremony-sysinit.conf
COPY image/firstboot/neural-ice-firstboot-tpm-ceremony.service \
     /usr/lib/neural-ice/firstboot-tpm-ceremony.service
COPY image/firstboot/neural-ice-firstboot-ceremony-generator \
     /usr/lib/neural-ice/firstboot-ceremony-generator
# Keep the destructive pre-activation token readback on the same checkout as
# the installer. A stale helper inherited from BASE_IMAGE can invert the
# PolicyAuthorize contract and reject a correctly enrolled target.
COPY ota/neural-ice-luks-token-evidence.py /usr/libexec/neural-ice-luks-token-evidence
COPY ota/neural-ice-lab-baseline-handoff.sh /usr/local/libexec/neural-ice-lab-baseline-handoff
COPY ota/neural-ice-autoinstall.service /usr/lib/systemd/system/neural-ice-autoinstall.service
COPY image/installer/neural-ice-installer.target \
     /usr/lib/systemd/system/neural-ice-installer.target
COPY image/installer/neural-ice-live.target \
     /usr/lib/systemd/system/neural-ice-live.target
COPY image/installer/neural-ice-installer-runtime-generator.sh \
     /usr/lib/systemd/system-generators/neural-ice-installer-runtime-generator
# THE SEALED COMMAND-LINE GRAMMAR, in the immutable /usr next to the access
# policy it is a sibling of. The early runtime generator and the autoinstaller
# both source it from here, so the medium has exactly ONE definition of which
# kernel command lines it may boot -- and it is inside the dm-verity root the
# signed UKI seals, not beside it.
COPY image/installer/neural-ice-sealed-cmdline-grammar.sh \
     /usr/lib/neural-ice/sealed-cmdline-grammar.sh
# THE LIVE MODE'S ONLY PRODUCT SURFACE: a bounded read-only diagnostic summary
# on tty1. Live used to reach basic.target and stop, which is safe and
# indistinguishable from a hung machine. It takes no input, opens no listener,
# writes nothing and is denied IP traffic outright; see its unit for each bound.
COPY image/installer/neural-ice-live-diagnostics.sh \
     /usr/libexec/neural-ice-live-diagnostics
COPY image/installer/neural-ice-live-diagnostics.service \
     /usr/lib/systemd/system/neural-ice-live-diagnostics.service
# 🔴 THE INSTALL FAILURE SINK (independent review 2026-09-02, P0 #1). The
# autoinstall unit used to carry `OnFailure=emergency.target`, and the early
# runtime generator unmasked emergency/rescue/debug-shell on every Install boot
# so that sink would resolve -- so any failure of a destructive install ended on
# a root shell on tty1. It now isolates onto a target that pulls exactly one
# output-only service: a bounded, fixed-vocabulary failure code and an automatic
# poweroff on the delay stated by the policy below, which lives in this immutable
# /usr and is therefore covered by the dm-verity root hash the UKI seals.
COPY image/installer/neural-ice-installer-failure.sh \
     /usr/libexec/neural-ice-installer-failure
COPY image/installer/neural-ice-installer-failure.service \
     /usr/lib/systemd/system/neural-ice-installer-failure.service
COPY image/installer/neural-ice-installer-failure.target \
     /usr/lib/systemd/system/neural-ice-installer-failure.target
COPY image/installer/installer-failure-policy \
     /usr/lib/neural-ice/installer-failure-policy
# 🔴 THE ONE SIGNATURE-POLICY READER (independent review 2026-09-02, P1 #2).
# image/build-installer-usb.sh runs this same file on the build host before a
# registry medium is cut, and ota/neural-ice-autoinstall.sh runs it twice at
# install time -- once before the pull and once with the index and platform-child
# digests the object resolved to. It lives in the immutable /usr the dm-verity
# root hash covers, beside the sealed grammar, so the medium has exactly ONE
# definition of what a signed docker scope has to state.
COPY image/installer/neural-ice-registry-authorisation.py \
     /usr/lib/neural-ice/registry-authorisation.py
# Install boots must never start getty@tty1 (its start job would resolve the
# autoinstall Conflicts= by stopping the install mid-flight). The distinct Live
# target pulls no getty at all, so it cannot inherit the debug image's root
# autologin or manufacture a second access path.
RUN install -d -m 0755 /etc/systemd/system/getty@tty1.service.d
COPY ota/neural-ice-getty-tty1-installer-skip.conf \
     /etc/systemd/system/getty@tty1.service.d/10-installer-skip.conf
COPY ota/neural-ice-device-root-tpm.sh /usr/libexec/neural-ice-device-root
# The installer reads the monotonic install counter at preflight, binds this
# appliance's access profile to a write-once TPM NV record once the install
# commits, and advances the release-authorization issuance high-water. The base
# image ships this helper too; copying it here keeps the medium's copy the same
# bytes as the appliance's, so the two readers of one record cannot drift.
COPY ota/neural-ice-tpm-state.sh /usr/libexec/neural-ice-tpm-state
COPY image/bootc-overlay/usr/lib/systemd/system/neural-ice-device-root.service \
     /usr/lib/systemd/system/neural-ice-device-root.service
RUN install -d -m 0755 /etc/systemd/system/neural-ice-device-root.service.d
COPY ota/neural-ice-device-root-installer-only.conf \
     /etc/systemd/system/neural-ice-device-root.service.d/10-installer-only.conf
RUN set -euxo pipefail; \
    chmod 0755 /usr/local/bin/neural-ice-autoinstall.sh \
      /usr/local/libexec/neural-ice-lab-baseline-handoff \
      /usr/libexec/neural-ice-luks-token-evidence \
      /usr/libexec/neural-ice-device-root \
      /usr/libexec/neural-ice-tpm-state \
      /usr/libexec/neural-ice-live-diagnostics \
      /usr/libexec/neural-ice-installer-failure \
      /usr/lib/systemd/system-generators/neural-ice-installer-runtime-generator \
      /usr/lib/neural-ice/firstboot-ceremony-generator; \
    chmod 0644 /usr/lib/neural-ice/sealed-cmdline-grammar.sh \
      /usr/lib/neural-ice/installer-failure-policy \
      /usr/lib/neural-ice/registry-authorisation.py; \
    bash -n /usr/libexec/neural-ice-installer-failure; \
    bash -n /usr/lib/neural-ice/firstboot-ceremony-generator; \
    python3 -c 'import ast,sys; [ast.parse(open(path).read()) for path in sys.argv[1:]]' \
      /usr/lib/neural-ice/registry-authorisation.py \
      /usr/libexec/neural-ice-luks-token-evidence; \
    # 🔴 THE MARKER THAT MAKES THE INSTALLER'S TEST SEAM IMPOSSIBLE HERE.
    # ota/neural-ice-autoinstall.sh consults an environment override for its
    # command-line file, sealed grammar, library directory, verity mount points,
    # store mapper and TPM helper ONLY when NI_INSTALLER_TEST_SEAM=1, the process
    # is unprivileged AND this file is absent. It is written into the read-only
    # /usr the dm-verity root hash covers, so on every medium this repository cuts
    # the third condition is false and the seam refuses even if the other two were
    # somehow met. A release image that lost this marker is a release image whose
    # trust gate could be pointed at a fixture: assert it, here, at build time.
    printf 'neural-ice-coreos-release-image-v1\n' > /usr/lib/neural-ice/release-image; \
    chmod 0444 /usr/lib/neural-ice/release-image; \
    test -e /usr/lib/neural-ice/release-image; \
    grep -q 'NI_RELEASE_IMAGE_MARKER="/usr/lib/neural-ice/release-image"' \
      /usr/local/bin/neural-ice-autoinstall.sh; \
    # The grammar must be SOURCEABLE by the generator that runs in early boot,
    # and the diagnostics summary must be runnable, or a Live boot reaches
    # nothing and an Install boot refuses itself. Assert both here rather than
    # discovering it on hardware.
    bash -n /usr/lib/neural-ice/sealed-cmdline-grammar.sh; \
    bash -n /usr/libexec/neural-ice-live-diagnostics; \
    # neural-ice-live-diagnostics.service is deliberately NOT enabled: the signed
    # Live target already carries `Wants=` for it, so no /etc symlink and no
    # persistent enablement is baked into a layer that also becomes the INSTALLED
    # appliance. The installed system never selects that target.
    test ! -e /etc/systemd/system/neural-ice-live.target.wants; \
    # The installer-only drop-in gates this enabled unit to the explicit
    # autoinstall entry.  Autoinstall removes that drop-in from the target
    # deployment before reboot, leaving the installed appliance enabled for
    # idempotent first-boot/runtime attestation.
    systemctl enable neural-ice-autoinstall.service neural-ice-device-root.service

# The base may be a composed APPLIANCE image, which carries bound-image links in
# /usr/lib/bootc/bound-images.d (ICE-Fabric #293). `bootc install to-filesystem`
# resolves them while writing this medium, against an image store that only
# exists on an INSTALLED system, and the media build dies:
#
#   resolving bound image …/working-memory@sha256:…: can't stat imageStore dir
#   /var/lib/neural-ice/data/seed-store: no such file or directory
#
# The preloaded path never hit this because it stages a seed store of its own, so
# the defect only surfaces on the LIGHT medium -- the architecture we are moving
# to (no models embedded, ADR-0040).
#
# ⚠️ WHAT THIS COSTS, precisely. That directory holds SYMLINKS into
# /usr/share/containers/systemd/neural-ice-bound-images/, and those 22 .image
# quadlets are NOT removed -- verified on the built installer image: 0 entries in
# bound-images.d, 22 quadlets still present. So the installed appliance keeps
# every image definition and podman still manages them. What is lost is the bootc
# LIFECYCLE COUPLING #293 established: an OS rollback no longer rolls back the
# application bytes with it.
#
# 🔴 That is a real deviation, not a no-op, and it lands on the INSTALLED system:
# the autoinstaller writes the deployment from this medium's own image
# (--source-imgref containers-storage:localhost/bootc), not from TARGET_IMGREF,
# which is only recorded as the future OTA origin. An earlier revision of this
# comment claimed the opposite and was wrong.
#
# It is accepted for a lab appliance whose rollbacks are supervised, and it is
# closed by making the medium install the APPLIANCE image rather than its own --
# which needs that image staged on the medium, and is the next change here.
RUN rm -rf /usr/lib/bootc/bound-images.d

# The grafted container signature policy is fail-closed and, by design, emits
# only the `docker` transport (image/policy/render-container-policy.sh: it
# "cannot emit insecureAcceptAnything anywhere"). Every LOCAL transport therefore
# falls to `default: reject`, and every step that reads a local image dies:
#
#   bootc-image-builder, writing this medium : containers-storage:…  rejected
#   the autoinstaller, reading its own store : containers-storage:…  rejected
#
# Enumerating transports is whack-a-mole -- the next bootc release picks another.
# The medium instead runs permissive and the STRICT policy travels beside it, to
# be restored onto the installed deployment by neural-ice-autoinstall before
# first boot. That is what keeps this exception to the medium, which is what was
# authorised: the appliance boots with the graft it was composed with.
#
# The signed docker scopes are preserved in the permissive policy too, so even
# here a registry pull is still verified against image-ci.
RUN python3 -c "import json,shutil; p='/etc/containers/policy.json'; d=json.load(open(p)); \
assert d.get('default')==[{'type':'reject'}], 'base policy is not fail-closed; refusing to relax an unknown policy'; \
assert 'docker' in d.get('transports',{}), 'base policy carries no signed docker scopes; refusing to relax an ungrafted policy'; \
shutil.copyfile(p,'/usr/lib/neural-ice-policy-strict.json'); \
d['default']=[{'type':'insecureAcceptAnything'}]; \
json.dump(d, open(p,'w'), indent=4, sort_keys=True)"

# Assert both halves rather than trusting the edit: the medium is permissive,
# the strict original is preserved verbatim for the autoinstaller to restore,
# and the signed docker scopes survive in both.
RUN python3 -c "import json; live=json.load(open('/etc/containers/policy.json')); strict=json.load(open('/usr/lib/neural-ice-policy-strict.json')); docker=live.get('transports',{}).get('docker'); \
assert live['default']==[{'type':'insecureAcceptAnything'}]; \
assert strict['default']==[{'type':'reject'}]; \
assert isinstance(docker,dict) and docker, 'installer policy carries no explicitly configured signed docker scope'; \
assert all(isinstance(scope,str) and scope and '/' in scope for scope in docker), 'installer policy carries a malformed docker scope'; \
assert strict['transports']==live['transports']; \
print('installer policy: medium permissive, strict original preserved for the target')"

# Branding (os-release, Plymouth, kargs) is inherited from the canonical image.
LABEL org.opencontainers.image.title="Neural ICE CoreOS (DGX Spark installer)" \
      neural-ice.role="installer-dualmode"
