{
  "$id": "https://neural-ice.ch/schemas/release-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_seq": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "minimum_reader": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "required_contracts": {
          "items": {"$ref": "#/$defs/identifier"},
          "maxItems": 128,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["minimum_reader", "required_contracts"],
      "type": "object"
    },
    "components": {
      "items": {"$ref": "#/$defs/component"},
      "maxItems": 256,
      "type": "array"
    },
    "content": {
      "items": {"$ref": "#/$defs/content"},
      "maxItems": 1024,
      "type": "array"
    },
    "evidence": {
      "items": {"$ref": "#/$defs/evidence"},
      "maxItems": 2048,
      "type": "array",
      "uniqueItems": true
    },
    "hardware_target": {
      "$ref": "#/$defs/identifier",
      "type": "string"
    },
    "host": {"$ref": "#/$defs/payload"},
    "release_id": {"$ref": "#/$defs/identifier"},
    "schema": {"const": "neural-ice-release-manifest-v1"}
  },
  "required": [
    "schema",
    "release_id",
    "bundle_seq",
    "hardware_target",
    "compatibility",
    "host",
    "components",
    "content",
    "evidence"
  ],
  "type": "object",
  "$defs": {
    "component": {
      "additionalProperties": false,
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "contract": {"$ref": "#/$defs/identifier"},
        "digest": {"$ref": "#/$defs/digest"},
        "reboot_required": {"type": "boolean"},
        "repository": {"$ref": "#/$defs/repository"},
        "required_entitlement": {"$ref": "#/$defs/entitlement"},
        "restart_scope": {"$ref": "#/$defs/restartScope"}
      },
      "required": [
        "component_id", "repository", "digest", "contract", "restart_scope",
        "reboot_required", "required_entitlement"
      ],
      "type": "object"
    },
    "content": {
      "additionalProperties": false,
      "properties": {
        "content_id": {"$ref": "#/$defs/identifier"},
        "contract": {"$ref": "#/$defs/identifier"},
        "digest": {"$ref": "#/$defs/digest"},
        "media_type": {
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$",
          "type": "string"
        },
        "reboot_required": {"type": "boolean"},
        "repository": {"$ref": "#/$defs/repository"},
        "required_entitlement": {"$ref": "#/$defs/entitlement"},
        "restart_scope": {"$ref": "#/$defs/restartScope"}
      },
      "required": [
        "content_id", "media_type", "repository", "digest", "contract",
        "restart_scope", "reboot_required", "required_entitlement"
      ],
      "type": "object"
    },
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "entitlement": {"pattern": "^[A-Z][A-Z0-9-]{0,63}$", "type": "string"},
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "kind": {
          "enum": ["attestation", "bom", "channel-snapshot", "lockfile", "receipt"]
        }
      },
      "required": ["kind", "digest"],
      "type": "object"
    },
    "identifier": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "contract": {"$ref": "#/$defs/identifier"},
        "digest": {"$ref": "#/$defs/digest"},
        "reboot_required": {"type": "boolean"},
        "repository": {"$ref": "#/$defs/repository"},
        "required_entitlement": {"$ref": "#/$defs/entitlement"},
        "restart_scope": {"$ref": "#/$defs/restartScope"}
      },
      "required": [
        "repository",
        "digest",
        "contract",
        "restart_scope",
        "reboot_required",
        "required_entitlement"
      ],
      "type": "object"
    },
    "repository": {
