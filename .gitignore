# Generated artifacts / secrets — never commit

# Build artifacts (regenerated from sources / RPMs / .run)
image/rpms/
image/rpms-driver/
image/driver-modules/
image/driver-modules-unsigned/
image/nvidia-userspace/
image/signed-boot/
# Measured hardware identity. A fingerprint nobody measured is exactly the
# invented vendor string image/hardware-identity/README.md exists to avoid, so
# every list stays ignored by default. The list for a target this tree actually
# SHIPS is un-ignored by exact name once its machines have been measured and the
# provenance comments name them: the media build needs it (HARDWARE_IDENTITY_FILE)
# and a staged-only file made every build depend on someone remembering to copy it.
image/hardware-identity/*.fingerprints
!image/hardware-identity/nvidia-gb10-arm64.fingerprints
# The release-authorization public key stays a staged build input (key ceremony).
image/keys/
image/generation.env
image/manifest.sha256
image/labkey/
image/bib-output/
build/output/
*.iso
*.img
*.img.xz
*.img.zst
# Media-build side files: the sealed-core facts the base build hands to the
# PRELOADED final gate, and the receipt that gate publishes.
*.img.sealed-core.json
*.img.final-media.json
*.img.final-media.json.sha256
*.img.zst.sha256
*.raw
*.run

# CI scratch
build.out

# Generated Ignition (machine-specific values / resolved placeholders)
ignition/*.ign

# Secrets / PKI / licenses
*.key
*.pem
**/pki/*.crt
!**/pki/ca.crt.example
*licence.json
*.token

# Misc
__pycache__/
*.log
.DS_Store


# Rust build artifacts (ni-ota-verify — Cargo.lock IS committed, the build must be hermetic)
tools/ni-ota-verify/target/
