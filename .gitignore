# Generated artifacts / secrets — never commit

# Build artifacts (regenerated from sources / RPMs / .run)
image/rpms/
image/rpms-driver/
image/driver-modules/
image/driver-modules-unsigned/
image/nvidia-userspace/
image/signed-boot/
# Measured hardware identity + the release-authorization public key: STAGED
# build inputs, produced by measuring the reference appliance and by the release
# key ceremony. Committing a fingerprint nobody measured would be exactly the
# invented vendor string image/hardware-identity/README.md exists to avoid.
image/hardware-identity/*.fingerprints
image/keys/
image/generation.env
image/manifest.sha256
image/labkey/
image/bib-output/
build/output/
*.iso
*.img
*.img.xz
*.img.zst
# Media-build side files: the sealed-core facts the base build hands to the
# PRELOADED final gate, and the receipt that gate publishes.
*.img.sealed-core.json
*.img.final-media.json
*.img.final-media.json.sha256
*.img.zst.sha256
*.raw
*.run

# CI scratch
build.out

# Generated Ignition (machine-specific values / resolved placeholders)
ignition/*.ign

# Secrets / PKI / licenses
*.key
*.pem
**/pki/*.crt
!**/pki/ca.crt.example
*licence.json
*.token

# Misc
__pycache__/
*.log
.DS_Store


# Rust build artifacts (ni-ota-verify — Cargo.lock IS committed, the build must be hermetic)
tools/ni-ota-verify/target/
